        "eslint": "9.39.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-svelte": "3.12.5",
        "globals": "16.5.0",
        "prettier": "3.6.2",
        "prettier-plugin-svelte": "3.4.0",
        "sass": "1.93.2",
        "svelte": "5.43.14",
        "svelte-check": "4.2.2",
        "typescript": "5.9.3",
        "typescript-eslint": "8.47.0",
        "vite": "7.2.4"
    },
